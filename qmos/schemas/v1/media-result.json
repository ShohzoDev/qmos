{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yuklangan fayl",
  "type": "object",
  "additionalProperties": false,
  "required": ["media_id", "sha256", "size_bytes", "content_type"],
  "properties": {
    "media_id": {"$ref": "common.json#/$defs/uuid"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
    "content_type": {"type": "string", "enum": ["image/jpeg", "image/png", "image/webp"]}
  }
}
